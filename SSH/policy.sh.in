s4_ssh_policy() {
    s4_ssh_candidate configuration
}

s4_ssh_service_policy() {
    s4_ssh_candidate service
}

s4_deployment_policy() {
    [[ $# == 1 ]] || return 64
    s4_ssh_candidate deployment "$1"
}

s4_deployment_publish() {
    [[ $# == 1 ]] || return 64
    s4_ssh_candidate publish "$1"
}

s4_application_service_policy() {
    [[ $# == 1 ]] || return 64
    s4_ssh_candidate applications "$1"
}

s4_application_publish() {
    [[ $# == 1 ]] || return 64
    s4_ssh_candidate publish-applications "$1"
}

s4_ssh_candidate() {
    [[ ( $# == 1 && ( $1 == configuration || $1 == service ) ) || ( $# == 2 && ( $1 == deployment || $1 == publish || $1 == applications || $1 == publish-applications ) ) ]] || return 64
    local allowance=30
    [[ $1 != publish ]] || allowance=90
    [[ $1 != applications ]] || allowance=300
    [[ $1 != publish-applications ]] || allowance=390
    # Policy actions only produce bytes. Explicit publish writes inactive private
    # bundles only; LAN/caller/key/native/activation authority remains unmet.
    timeout --kill-after=5s "${allowance}s" python3 -I - "$@" <<'PY'
__name__ = 's4_ssh_candidate_library'
# @s4-include SSH/policy.py
# @s4-include SSH/service.py
# @s4-include Deployment/configuration.py
# @s4-include Deployment/policy.py
# @s4-include Deployment/postgresql_profile.py
# @s4-include Deployment/publication.py
# @s4-include Deployment/releases.py
# @s4-include Deployment/dns_configuration.py
# @s4-include Deployment/credentials.py
# @s4-include Deployment/email_credentials.py
# @s4-include Deployment/email_role_policy.py
# @s4-include Deployment/email_transport.py
# @s4-include Deployment/email_presentation.py
# @s4-include Deployment/drava_bootstrap.py
# @s4-include Deployment/services.py
# @s4-include Deployment/database_correspondence.py
# @s4-include Deployment/sava_policy.py
# @s4-include Deployment/application_publication.py
# @s4-include Deployment/application_installation.py
# @s4-include Deployment/application_rollback.py
# @s4-include Deployment/application_reinstallation.py
action = sys.argv[1]
if action == 'publish-applications':
    sys.argv = [sys.argv[0], sys.argv[2]]
    raise SystemExit(application_publication_main(bundle))
if action == 'applications':
    sys.argv = [sys.argv[0], sys.argv[2]]
    raise SystemExit(application_main(bundle))
if action == 'publish':
    sys.argv = [sys.argv[0], sys.argv[2]]
    raise SystemExit(publication_main(bundle))
if action == 'deployment':
    sys.argv = [sys.argv[0], sys.argv[2]]
    raise SystemExit(deployment_main(bundle))
sys.argv = [sys.argv[0]]
raise SystemExit(main() if action == 'configuration' else service_main(bundle))
PY
}
