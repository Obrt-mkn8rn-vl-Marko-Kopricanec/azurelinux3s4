<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>S4.ManagedImports</AssemblyName>
    <RootNamespace>S4.ManagedImports</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UseSharedCompilation>false</UseSharedCompilation>
    <UseAppHost>false</UseAppHost>
    <DebugType>none</DebugType>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer" Version="[3.0.307]" PrivateAssets="all" IncludeAssets="analyzers;build;buildtransitive" />
    <PackageReference Include="Roslynator.Analyzers" Version="[5.0.1]" PrivateAssets="all" IncludeAssets="analyzers;build;buildtransitive" />
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="[18.12.1]" PrivateAssets="all" IncludeAssets="analyzers;build;buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="[5.6.0]" PrivateAssets="all" IncludeAssets="analyzers;build;buildtransitive" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>
</Project>
